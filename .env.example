# =============================================================================
#  Agentic AI Discharge Summaries — environment template
#  Copy to `.env` and fill in your own credentials:   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
#  1. LLM PROVIDER
# -----------------------------------------------------------------------------
#  bedrock → Amazon Bedrock Converse API (Nova Lite + Cohere Command R+).
#            This is the only supported provider.
LLM_PROVIDER=bedrock

# -----------------------------------------------------------------------------
#  2. AMAZON BEDROCK
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
#  DO NOT put AWS keys in this file. Credentials are resolved automatically by
#  the boto3 default chain, in this order:
#      1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN in the
#         *process* environment
#      2. the shared credentials file written by `aws configure`
#      3. AWS_PROFILE / the shared config file
#      4. the instance / container / IAM role
#  Run `aws configure` once and everything below just works.

# Primary multilingual model (spec: Amazon Nova Lite) — the DEFAULT model
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Fallback / English-heavy model (spec: Cohere Command R+)
BEDROCK_FALLBACK_MODEL_ID=cohere.command-r-plus-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Rate-limit handling -----------------------------------------------------
# Bedrock enforces per-account requests-per-minute quotas. The provider layer
# retries ThrottlingException / 429 with exponential backoff.
LLM_MAX_RETRIES=3
LLM_MAX_RETRY_WAIT=62
# Attempts made inside botocore. Keep at 1 so this project owns the retry
# policy — the SDK's own loop would otherwise nest inside ours.
LLM_SDK_RETRIES=1
# Set to a positive number of seconds to space calls out under a tight quota.
# 0 disables client-side throttling.
LLM_MIN_INTERVAL_SECONDS=0
# After a hard quota error, stop attempting LLM calls for this long (seconds).
# The framework SDKs run their own un-configurable retry loops, so without this
# every later call wastes ~30s of pointless backoff. 0 disables the breaker.
LLM_BREAKER_COOLDOWN_SECONDS=900

# -----------------------------------------------------------------------------
#  3. EMBEDDINGS
# -----------------------------------------------------------------------------
#  bedrock               → Amazon Titan Text Embeddings V2 (default; uses the
#                          same AWS credentials as the chat models)
#  sentence_transformers → spec model all-MiniLM-L6-v2 (pip install -r requirements-optional.txt)
#  hashing               → offline deterministic fallback, zero dependencies
EMBEDDING_PROVIDER=bedrock
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
#  4. LANGFUSE OBSERVABILITY  (leave keys blank to disable tracing gracefully)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# -----------------------------------------------------------------------------
#  5. A2A SHARED-SECRET AUTH  (sent as X-Agent-Auth-Token on every A2A call)
# -----------------------------------------------------------------------------
A2A_AUTH_TOKEN=change-me-shared-secret

# -----------------------------------------------------------------------------
#  6. MISC
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Set to 1 to skip all outbound LLM calls and use deterministic offline stubs
# (useful for demos without network / quota).
OFFLINE_MODE=0
